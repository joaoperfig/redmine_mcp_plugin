<%
  # `settings` is the plugin settings hash Redmine hands to this partial. It has
  # STRING keys once saved, but SYMBOL keys on a fresh install where it is still
  # init.rb's defaults hash verbatim. Normalise once, here, or every field in the
  # tabs renders blank until an administrator saves the form for the first time.
  #
  # All tabs sit inside core's one settings form, so Apply saves them together.
  # Core's tab partial passes each tab only its own hash, hence settings in it.
  settings = settings.to_h.with_indifferent_access
%>
<%= render_tabs [
  { name: 'general', label: 'redmine_mcp.settings.tab_general',
    partial: 'settings/redmine_mcp/general', settings: settings },
  { name: 'prompts', label: 'redmine_mcp.settings.tab_prompts',
    partial: 'settings/redmine_mcp/prompts', settings: settings },
  { name: 'tools', label: 'redmine_mcp.settings.tab_tools',
    partial: 'settings/redmine_mcp/tools', settings: settings }
] %>

<%= javascript_tag do %>
  $(function () {
    // The Prompts and Tools tabs show each text in force, and carry its
    // built-in default in data-default. A field still equal to its default is
    // blanked before submitting, so nothing is stored for it and
    // Settings.text keeps following the default as it changes between
    // releases. dataset rather than jQuery's .data(), which would parse a
    // default that happens to look like JSON.
    var fields = $('textarea[data-default]');
    var trimmed = function (text) { return text.replace(/\s+$/, ''); };

    $('.mcp-restore').on('click', function (event) {
      event.preventDefault();
      $(this).closest('fieldset').find('textarea[data-default]').each(function () {
        this.value = this.dataset.default;
      });
    });

    fields.first().closest('form').on('submit', function () {
      fields.each(function () {
        if (trimmed(this.value) === trimmed(this.dataset.default)) this.value = '';
      });
    });
  });
<% end %>
