<%
  # Each field shows the text in force: the stored edit, or the built-in default
  # until someone edits it. See the container partial for how unchanged fields
  # are kept out of the stored settings.
  placeholder = RedmineMcp::Prompts::Base::REQUEST_PLACEHOLDER
  fields = [
    { key: 'server_instructions',
      title: l('redmine_mcp.settings.server_instructions'),
      info: l('redmine_mcp.settings.server_instructions_hint'),
      default: RedmineMcp::McpServer::INSTRUCTIONS, rows: 6 }
  ] + RedmineMcp::Prompts.all.map do |prompt|
    { key: prompt.setting_key, title: prompt.title, info: prompt.description,
      default: prompt::DEFAULT_TEXT, rows: 30, request: true }
  end
%>

<p><em class="info"><%= l('redmine_mcp.settings.prompts_intro') %></em></p>

<% fields.each do |field| %>
  <fieldset class="box mcp-prompt">
    <legend><%= field[:title] %></legend>
    <p><em class="info"><%= field[:info] %></em></p>
    <%= text_area_tag "settings[#{field[:key]}]",
                      RedmineMcp::Settings.text(field[:key], field[:default]),
                      id: "settings_#{field[:key]}", rows: field[:rows], spellcheck: false,
                      style: 'width: 100%; box-sizing: border-box; font-family: monospace;',
                      data: { default: field[:default] } %>
    <p>
      <% if field[:request] %>
        <em class="info"><%= l('redmine_mcp.settings.prompt_request_hint', placeholder: placeholder) %></em>
      <% end %>
      <%= link_to sprite_icon('reload', l('redmine_mcp.settings.restore_default')), '#',
                  class: 'icon mcp-restore' %>
    </p>
  </fieldset>
<% end %>
