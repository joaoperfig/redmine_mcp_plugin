<%
  # Only description text is editable; see Tools::Base.to_h for why names,
  # types, required parameters, and bounds stay code-owned. Sections start
  # collapsed, sixteen tools being too long a page to scroll open.
  settings = tab[:settings]
%>

<p><em class="info"><%= l('redmine_mcp.settings.tools_intro') %></em></p>

<% RedmineMcp::Registry.all.each do |tool| %>
  <%
    schema     = tool.input_schema_value.to_h
    required   = Array(schema[:required]).map(&:to_s)
    parameters = schema[:properties].to_h.map do |name, spec|
      { key: tool.parameter_setting_key(name), name: name.to_s, default: spec[:description].to_s,
        type: Array(spec[:type]).join(' | '), required: required.include?(name.to_s) }
    end
    keys   = [tool.description_setting_key] + parameters.pluck(:key)
    edited = keys.any? { |key| settings[key].to_s.strip.present? }
  %>
  <fieldset class="box collapsible collapsed mcp-tool">
    <legend onclick="toggleFieldset(this);" class="icon icon-collapsed">
      <%= sprite_icon('angle-right', rtl: true) %>
      <%= tool.title %> <code><%= tool.name_value %></code>
      <% if edited %><em class="info">(<%= l('redmine_mcp.settings.edited') %>)</em><% end %>
    </legend>
    <div style="display: none;">
      <p>
        <label for="settings_<%= tool.description_setting_key %>"><%= l('redmine_mcp.settings.tool_description') %></label>
        <%= text_area_tag "settings[#{tool.description_setting_key}]",
                          RedmineMcp::Settings.text(tool.description_setting_key, tool.description_value.to_s),
                          id: "settings_#{tool.description_setting_key}", rows: 3, spellcheck: false,
                          style: 'width: 100%; box-sizing: border-box;',
                          data: { default: tool.description_value.to_s } %>
      </p>
      <% parameters.each do |parameter| %>
        <p>
          <label for="settings_<%= parameter[:key] %>"><code><%= parameter[:name] %></code></label>
          <%= text_area_tag "settings[#{parameter[:key]}]",
                            RedmineMcp::Settings.text(parameter[:key], parameter[:default]),
                            id: "settings_#{parameter[:key]}", rows: 2, spellcheck: false,
                            style: 'width: 100%; box-sizing: border-box;',
                            data: { default: parameter[:default] } %>
          <em class="info">
            <%= parameter[:type] %><%= ", #{l('redmine_mcp.settings.parameter_required')}" if parameter[:required] %>
          </em>
        </p>
      <% end %>
      <p>
        <%= link_to sprite_icon('reload', l('redmine_mcp.settings.restore_defaults')), '#',
                    class: 'icon mcp-restore' %>
      </p>
    </div>
  </fieldset>
<% end %>
