<%
  # The prompt records live in the database and are edited in place. The whole
  # settings page is one form, so each row's index and formaction button keep
  # its Save/Delete action separate without nesting forms.
  scope = RedmineMcpPlugin::Prompt.sorted
  prompt_pages = Redmine::Pagination::Paginator.new(scope.count, 25, params[:page])
  prompts = scope.offset(prompt_pages.offset).limit(prompt_pages.per_page).to_a
  server_instructions = RedmineMcpPlugin::Settings.text(
    'server_instructions', RedmineMcpPlugin::McpServer::INSTRUCTIONS
  )
%>

<%= hidden_field_tag 'prompt_page', prompt_pages.page, id: nil %>

<fieldset class="box">
  <legend><%= l('redmine_mcp_plugin.settings.server_instructions') %></legend>
  <p><em class="info"><%= l('redmine_mcp_plugin.settings.server_instructions_hint') %></em></p>
  <%= text_area_tag 'settings[server_instructions]', server_instructions,
                    id: 'settings_server_instructions', rows: 6, spellcheck: false,
                    style: 'width: 100%; box-sizing: border-box; resize: vertical;',
                    data: { default: RedmineMcpPlugin::McpServer::INSTRUCTIONS } %>
  <p>
    <%= link_to sprite_icon('reload', l('redmine_mcp_plugin.settings.restore_default')), '#',
                class: 'icon mcp-restore' %>
  </p>
</fieldset>

<p><em class="info"><%= l('redmine_mcp_plugin.settings.prompts_intro') %></em></p>

<% prompts.each do |prompt| %>
  <%= render partial: 'settings/redmine_mcp_plugin/prompt_form', locals: { prompt: prompt } %>
<% end %>

<% if prompt_pages.multiple_pages? %>
  <div class="pagination"><%= pagination_links_full prompt_pages %></div>
<% end %>

<%= render partial: 'settings/redmine_mcp_plugin/prompt_form',
           locals: { prompt: RedmineMcpPlugin::Prompt.new } %>
